<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head', { pageTitle, pageDescription }) %>
  </head>
  <body class="min-h-screen text-slate-900">
    <%- include('../partials/header') %>

    <main class="mx-auto max-w-7xl px-6 py-10">
      <section class="page-shell-band mb-10 p-8">
        <p class="page-shell-label text-sm font-semibold uppercase">
          <%= pageName %>
        </p>
        <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-[color:var(--brand-ink)] md:text-5xl">
          <%= pageHeading %>
        </h1>
        <p class="page-shell-muted mt-4 max-w-3xl text-base leading-7">
          <%= pageDescription %>
        </p>
      </section>

      <section class="grid gap-6 lg:grid-cols-2">
        <% componentPlan.forEach((component) => { %>
            <%- include('../partials/lit-host', {
            tag: component.tag,
            props: component.props,
            variant: 'standard'
            }) %>
        <% }) %>
      </section>

      <section class="page-shell-card mt-10 p-8">
        <h2 class="text-xl font-bold text-[color:var(--brand-ink)]">Negotiation workflow</h2>
        <p class="page-shell-muted mt-3 text-sm leading-6">
          This page brings together listing context, messaging, offer negotiation,
          checkout state, and seller confirmation flow.
        </p>
      </section>
    </main>

    <%- include('../partials/scripts') %>
  </body>
</html>