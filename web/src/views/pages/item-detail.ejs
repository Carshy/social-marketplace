<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head', { pageTitle, pageDescription }) %>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <%- include('../partials/header') %>

    <main class="mx-auto max-w-7xl px-6 py-10">
      <section class="mb-10">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-slate-500">
          <%= pageName %>
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900">
          <%= pageHeading %>
        </h1>
        <p class="mt-4 max-w-3xl text-base leading-7 text-slate-600">
          <%= pageDescription %>
        </p>
      </section>

      <section class="grid gap-6 lg:grid-cols-2">
        <% componentPlan.forEach((component) => { %>
          <%- include('../partials/lit-host', {
            tag: component.tag,
            props: component.props
          }) %>
        <% }) %>
      </section>

      <section class="mt-10 rounded-3xl border border-dashed border-slate-300 bg-white p-8">
        <h2 class="text-xl font-semibold text-slate-900">Item detail shell complete</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">
          This page is now server-planning the item detail, offer panel, chat thread, and checkout panel.
          In the next phase we will turn these into real Lit components wired to the backend.
        </p>
      </section>
    </main>
  </body>
</html>