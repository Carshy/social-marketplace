<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head', { pageTitle }) %>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <header class="border-b border-slate-200 bg-white/90 backdrop-blur">
      <div class="mx-auto max-w-6xl px-6 py-5">
        <div class="flex flex-col gap-2">
          <p class="text-sm font-medium uppercase tracking-[0.2em] text-slate-500">
            Social Marketplace
          </p>
          <h1 class="text-3xl font-bold tracking-tight">
            Collectible Trading Post
          </h1>
          <p class="max-w-2xl text-sm text-slate-600">
            EJS shell first. Lit components next. Tailwind styling already active.
          </p>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-6 py-10">
      <section class="grid gap-6 md:grid-cols-2">
        <% componentPlan.forEach((component) => { %>
          <%- include('../partials/lit-host', {
            tag: component.tag,
            props: component.props
          }) %>
        <% }) %>
      </section>

      <section class="mt-10 rounded-3xl border border-dashed border-slate-300 bg-white p-8">
        <h2 class="text-xl font-semibold">Phase 0 checkpoint</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">
          Once this page loads correctly and the CSS is applied, the project setup is healthy.
          After that, we move to backend stabilization and real component implementation.
        </p>
      </section>
    </main>
  </body>
</html>